# ============================================================
# Dalal Street AI — configuration
# Copy to .env and fill in. Never commit .env.
# ============================================================

# --- LLM (required) -----------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for the function-calling loop and self-validation.
GEMINI_MODEL=gemini-2.5-flash

# --- Database -----------------------------------------------
# Path to the SQLite warehouse. Relative paths resolve from the
# repository root. Build one with: python scripts/bootstrap_db.py --sample
DB_PATH=App/database/stock_market_new.db

# --- Backend ------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated list of origins allowed to call the API.
# Use explicit origins in production. "*" is not accepted with credentials.
CORS_ORIGINS=http://localhost:8501

# Bearer token required by /admin/* endpoints.
# Leave empty to disable those endpoints entirely (recommended).
ADMIN_TOKEN=

# Enable uvicorn autoreload and debug logging. Never true in production.
DEV_RELOAD=false

# --- Frontend -----------------------------------------------
# URL the Streamlit frontend uses to reach the backend.
API_BASE_URL=http://localhost:8000

# --- Tuning -------------------------------------------------
# In-process live-price cache TTL, seconds.
PRICE_CACHE_TTL_SEC=60

# --- Optional -----------------------------------------------
# Only used by the unwired multi-provider abstraction. See docs/ROADMAP.md.
# GROQ_API_KEY=
# LLM_PROVIDER=gemini
