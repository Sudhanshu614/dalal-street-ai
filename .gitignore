# =============================================================
# Dalal Street AI — .gitignore
#
# Principle: exclude SECRETS, DATA, and BUILD ARTEFACTS.
# Never exclude source code by filename pattern.
#
# The previous version blanket-ignored test_*.py, check_*.py,
# analyze_*.py, *.json and *.txt, which silently left the entire
# ingestion pipeline untracked. Do not reintroduce that.
# If a file is junk, delete it — do not pattern-ignore it.
# =============================================================

# -------------------------------------------------------------
# SECRETS — never commit
# -------------------------------------------------------------
.env
.env.*
!.env.example
App/.env
*service-account*.json
*credentials*.json
*.pem
*.key
.private/

# -------------------------------------------------------------
# DATA — excluded for licensing reasons, not just size.
# See docs/DATA.md before publishing anything you build.
# -------------------------------------------------------------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
App/database/backups/

# NSE source files the pipeline consumes (user downloads these)
App/database/*.csv
App/database/*.xlsx

# Kaggle / dataset export output
dist/
export/

# -------------------------------------------------------------
# CACHES & LOGS
# -------------------------------------------------------------
cache/
App/cache/
logs/
App/logs/
*.log

# -------------------------------------------------------------
# PYTHON
# -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# -------------------------------------------------------------
# EDITORS & OS
# -------------------------------------------------------------
.vscode/
.idea/
.trae/
.DS_Store
Thumbs.db
desktop.ini

# -------------------------------------------------------------
# SCRATCH — historical working directory, not part of the project
# -------------------------------------------------------------
extra/
doc/
context.txt

# -------------------------------------------------------------
# EXPLICIT KEEPS
# Guard against a future pattern accidentally swallowing these.
# -------------------------------------------------------------
!App/**/*.py
!scripts/**/*.py
!tests/**/*.py
!tests/fixtures/**
!.github/**
!docs/**
!*.md
!requirements*.txt
!docker-compose.yml
!pytest.ini
